# Execute npm run env:setup para criar .env local com senhas aleatórias.
# Não compartilhe valores entre desenvolvimento e demonstração.
APP_ENV=development
DATABASE_ID=prevision-local-development
POSTGRES_DB=prevision_dev
POSTGRES_USER=prevision_admin
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_LOCAL_PASSWORD
POSTGRES_PORT=55432
DATABASE_URL=postgresql://prevision_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:55432/prevision_dev?schema=public
DIRECT_URL=postgresql://prevision_admin:REPLACE_WITH_ADMIN_PASSWORD@127.0.0.1:55432/prevision_dev?schema=public
# Execute npm run auth:setup para acrescentar estes campos ao .env existente.
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_URL=http://127.0.0.1:3000
# Na Vercel, a identificação do cliente usa o cabeçalho do próprio provedor.
# Em outro ingresso HTTPS, configure APENAS um cabeçalho que o proxy confiável
# remova/substitua por um único IP e impeça acesso direto à aplicação.
# REQUEST_IP_HEADER=x-real-ip
MAIL_TRANSPORT=local
MAIL_FROM=Prevision <nao-responda@example.invalid>
# Configure ambos para habilitar Google; callback local:
# http://127.0.0.1:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Para envio real: MAIL_TRANSPORT=smtp e remetente válido em MAIL_FROM.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
